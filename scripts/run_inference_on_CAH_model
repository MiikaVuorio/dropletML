import torch
import torch.nn as nn
from torchvision import models
import numpy as np
import argparse
import os
import matplotlib.pyplot as plt
import time

class HeatmapResNet(nn.Module):
    def __init__(self, in_channels=50, grid_size=16):
        super().__init__()
        base_resnet = models.resnet18(weights=models.ResNet18_Weights.DEFAULT)
        self.modify_first_layer(base_resnet, in_channels)
        self.backbone = nn.Sequential(*list(base_resnet.children())[:-2])
        self.pooling_layer = nn.AdaptiveAvgPool2d((1, 1))
        self.regressor_head = nn.Linear(
            in_features=512,  
            out_features=grid_size * grid_size
        )
        self.grid_size = grid_size

    def modify_first_layer(self, model, in_channels):
        """
        Modifies the first convolutional layer of the ResNet model to accept a custom
        number of input channels instead of the default 3 (RGB).
        """
        new_conv1 = nn.Conv2d(
            in_channels=in_channels,
            out_channels=model.conv1.out_channels,
            kernel_size=model.conv1.kernel_size,
            stride=model.conv1.stride,
            padding=model.conv1.padding,
            bias=False
        )
        
        with torch.no_grad():
            original_weights = model.conv1.weight.clone()
            avg_weights = torch.mean(original_weights, dim=1, keepdim=True)
            new_conv1.weight = nn.Parameter(avg_weights.repeat(1, in_channels, 1, 1))
        
        model.conv1 = new_conv1

    def forward(self, x):
        """Defines the forward pass of the model."""
        x = self.backbone(x)
        
        x = self.pooling_layer(x)
        x = torch.flatten(x, 1)
        
        x = self.regressor_head(x)
        
        output_grid = x.view(-1, self.grid_size, self.grid_size)

        return output_grid

def preprocess_sample(npz_path):
    """
    Loads and preprocesses a single .npz file to match the input format
    expected by the model during training.
    
    Args:
        npz_path (str): The file path to the .npz sample.

    Returns:
        torch.Tensor: A tensor ready to be fed into the model.
    """
    try:
        data = np.load(npz_path)
    except FileNotFoundError:
        print(f"Error: The file '{npz_path}' was not found.")
        return None
        
    images = data['images']
    masks = data['masks']
    
    # Interleave images and masks just like in the WettingDataset
    # The resulting shape will be (num_channels, height, width)
    combined_input = np.empty((images.shape[0] * 2, *images.shape[1:]), dtype=np.uint8)
    combined_input[0::2] = images
    combined_input[1::2] = masks
    
    # Convert to a PyTorch tensor, normalize pixel values to the 0-1 range,
    # and add a batch dimension (B, C, H, W) as the model expects a batch.
    input_tensor = torch.from_numpy(combined_input).float() / 255.0
    input_tensor = input_tensor.unsqueeze(0) # Add batch dimension: [C, H, W] -> [1, C, H, W]
    
    return input_tensor

def run_inference(model_path, npz_path, in_channels, grid_size):
    """
    Main function to run inference on a single sample.
    
    Args:
        model_path (str): Path to the saved model state dictionary (.pth file).
        npz_path (str): Pathmode.l() to the input .npz sample file.
        in_channels (int): Number of input channels the model was trained with.
        grid_size (int): The dimension of the output grid (e.g., 16 for a 16x16 grid).
    """
    # --- Setup Device and Model ---
    device = "cuda" if torch.cuda.is_available() else "cpu"
    print(f"Using device: {device}")

    # Initialize the model architecture
    model = HeatmapResNet(in_channels=in_channels, grid_size=grid_size).to(device)

    # Load the trained weights
    try:
        model.load_state_dict(torch.load(model_path, map_location=device))
        print(f"Successfully loaded model from {model_path}")
    except FileNotFoundError:
        print(f"Error: Model file not found at '{model_path}'. Please check the path.")
        return
    except Exception as e:
        print(f"Error loading model state_dict: {e}")
        return

    # Set the model to evaluation mode
    # This disables layers like Dropout and BatchNorm from updating.
    model.eval()

    # --- Load and Preprocess Data ---
    print(f"Loading and preprocessing sample: {npz_path}")
    input_tensor = preprocess_sample(npz_path)
    if input_tensor is None:
        return
        
    input_tensor = input_tensor.to(device)

    # --- Perform Inference ---
    print("Running inference...")

    if device == "cuda":
        # For GPU, use torch.cuda.Event for accurate timing
        start_event = torch.cuda.Event(enable_timing=True)
        end_event = torch.cuda.Event(enable_timing=True)
        
        with torch.no_grad():
            start_event.record()
            predicted_heatmap = model(input_tensor)
            end_event.record()
        
        # Wait for the events to complete
        torch.cuda.synchronize()
        
        inference_duration_ms = start_event.elapsed_time(end_event)
        inference_duration_s = inference_duration_ms / 1000.0

    else: # For CPU, use the standard 'time' module
        start_time = time.time()
        with torch.no_grad():
            predicted_heatmap = model(input_tensor)
        end_time = time.time()
        
        inference_duration_s = end_time - start_time
        inference_duration_ms = inference_duration_s * 1000

    print(f"-> Inference took {inference_duration_s:.4f} seconds ({inference_duration_ms:.2f} ms)")


    # --- Process and Save the Output ---
    # Move the output tensor to the CPU and convert it to a NumPy array
    # Squeeze to remove the batch dimension: [1, 16, 16] -> [16, 16]
    heatmap_np = predicted_heatmap.squeeze(0).cpu().numpy()

    # Save the raw numerical output
    np.save("predicted_heatmap.npy", heatmap_np)
    print("Predicted heatmap saved to 'predicted_heatmap.npy'")

    # --- Visualize and Save the Output ---
    plt.figure(figsize=(8, 6))
    plt.imshow(heatmap_np, cmap='viridis', interpolation='nearest')
    plt.colorbar(label='Predicted Value')
    plt.title(f'Predicted Heatmap for\n{os.path.basename(npz_path)}')
    plt.xlabel('Grid X')
    plt.ylabel('Grid Y')
    
    # Save the visualization as a PNG file
    plt.savefig("predicted_heatmap.png")
    print("Visualized heatmap saved to 'predicted_heatmap.png'")
    # plt.show() # Uncomment this line if you want to display the plot directly

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Run inference with a trained HeatmapResNet model on a single .npz sample.")
    
    parser.add_argument("--model_path", type=str, required=True, help="Path to the saved model weights file (.pth). For example: 'heatmap_resnet_final.pth'.")
    parser.add_argument("--npz_path", type=str, required=True, help="Path to the .npz sample file to run inference on.")
    parser.add_argument("--in_channels", type=int, default=50, help="Number of input channels the model expects (must match training).")
    parser.add_argument("--grid_size", type=int, default=16, help="The output grid size of the model (must match training).")
    
    args = parser.parse_args()

    run_inference(args.model_path, args.npz_path, args.in_channels, args.grid_size)